# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Anything prefixed VITE_ is inlined into the browser bundle at build time and is
# therefore public. Secrets must use the unprefixed names.

# ── Supabase ────────────────────────────────────────────────────────────────
# Settings → API Keys. The server reads the unprefixed names and the browser
# reads the VITE_ ones, so both pairs need the same value.
#
# Use the new key format: the publishable key (sb_publishable_...) and a secret
# key (sb_secret_...). Projects created from late 2025 onwards no longer issue
# the legacy `anon` / `service_role` JWTs, and those are deprecated anyway. The
# client handles both formats (see isNewSupabaseApiKey in
# integrations/supabase/client.ts), so a legacy anon JWT still works if that is
# what an older project gives you.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Elevated: bypasses RLS entirely. Server-side only, never expose to the browser
# and never put it in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL of this deployment. Used to build links in transactional email,
# so a staging deploy must set its own value or its emails will point at prod.
APP_URL=http://localhost:5000

# ── PulseAssist (optional) ──────────────────────────────────────────────────
# Without a key the AI endpoints return AI_NOT_CONFIGURED and the UI says so.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Transactional email (optional) ──────────────────────────────────────────
# Without RESEND_API_KEY, pitches and verification decisions still land in-app
# and the UI reports that no email went out.
RESEND_API_KEY=
# Required whenever RESEND_API_KEY is set. The domain must be verified in Resend;
# there is deliberately no fallback, since Resend's sandbox domain can only
# deliver to the API key owner.
RESEND_FROM_EMAIL=The Ledger <noreply@yourdomain.com>

# ── Admin panel (optional) ──────────────────────────────────────────────────
# Hostname allowed to reach /admin. In a production build, leaving this unset
# blocks /admin entirely — it fails closed. localhost is always allowed.
# Admin authority itself comes from a user_roles row, not from this variable.
VITE_ADMIN_DOMAIN=

# ── Sign-in providers ──────────────────────────────────────────────────────
# Comma-separated OAuth providers to show on the sign-in card, e.g.
# "github,google,twitter". Each one must first be enabled in Supabase under
# Authentication -> Providers with real client credentials; listing a provider
# that is not configured renders a button that can only fail. Leave empty for
# email-only sign-in.
VITE_AUTH_PROVIDERS=

# ── Legal (optional) ───────────────────────────────────────────────────────
# Link target for "terms" on the sign-in card. Plain text when unset.
VITE_TERMS_URL=

# ── Error monitoring (optional) ────────────────────────────────────────────
# A Sentry-compatible DSN. Works with Sentry, GlitchTip and Bugsink — the app
# speaks the envelope protocol over fetch rather than bundling an SDK, so there
# is no client bundle cost when these are unset (which disables reporting).
#
# Two variables because the two runtimes report separately: the unprefixed one
# is read by the SSR server and never reaches the browser, the VITE_ one is
# inlined into the bundle. A DSN is safe to expose — it only grants the ability
# to write events to one project. Set both to the same value unless you want
# server and browser errors in different projects.
#
# The ingest origin is added to the CSP connect-src automatically (see
# contentSecurityPolicy in src/server.ts); a DSN set only at build time, with the
# server variable missing, would have its reports blocked by the policy.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Tags every report with the build it came from, so a stack trace can be tied to
# a deploy. On Railway this is filled in automatically from the commit SHA.
APP_RELEASE=
VITE_APP_RELEASE=

# ── Billing (optional) ─────────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY the /billing screen says checkout is unavailable and
# the upgrade buttons are disabled. Nothing else changes: entitlements already
# fall back to the verification tier, so the app is fully usable unpriced.
#
# Secret key from Stripe → Developers → API keys. Server-side only; never give
# this a VITE_ prefix.
STRIPE_SECRET_KEY=
# The recurring price the upgrade button buys. Stripe → Product catalogue → your
# product → pricing → "price_..." (a price id, not a product id).
STRIPE_PRICE_ID=
# Signing secret for the webhook endpoint, from Stripe → Developers → Webhooks
# after adding <APP_URL>/api/stripe/webhook. Required: without it the webhook
# rejects every delivery, because an unverified payload is an unauthenticated
# request that can set a subscription's status.
#
# Subscribe the endpoint to: checkout.session.completed,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=


# ── Supabase Auth settings that are NOT in this file ────────────────────────
# These live in the Supabase dashboard (Authentication → …) and no environment
# variable controls them, so they are easy to miss when standing up a new
# project. The app's behaviour depends on all four:
#
#   Site URL              must be the deployment's https:// origin, scheme
#                         included. A value without the scheme breaks every
#                         emailed link.
#   Redirect allow-list   must include <origin>/** so /reset-password and the
#                         OAuth/confirmation callbacks are accepted.
#   Confirm email         currently OFF, which means signups are auto-confirmed
#                         and nobody has to own the address they register. Turning
#                         it on requires custom SMTP first (see below), otherwise
#                         new accounts cannot be confirmed at all.
#   Minimum password      8, matching MIN_PASSWORD_LENGTH in src/lib/limits.ts.
#                         If they drift, the form accepts a password the auth
#                         server then rejects.
#
# Custom SMTP is the one to fix before launch. Without it Supabase's shared
# sender is capped at a couple of emails per hour, which is enough to test with
# and nowhere near enough to run signup confirmation or password resets for real
# users. Password reset is implemented and works, but it can only be as reliable
# as the mail path underneath it.
