# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Anything prefixed VITE_ is inlined into the browser bundle at build time and is
# therefore public. Secrets must use the unprefixed names.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The server reads the unprefixed names and the browser
# reads the VITE_ ones, so both pairs need to be set to the same values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Bypasses RLS. Server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL of this deployment. Used to build links in transactional email,
# so a staging deploy must set its own value or its emails will point at prod.
APP_URL=http://localhost:5000

# ── PulseAssist (optional) ──────────────────────────────────────────────────
# Without a key the AI endpoints return AI_NOT_CONFIGURED and the UI says so.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Transactional email (optional) ──────────────────────────────────────────
# Without RESEND_API_KEY, pitches and verification decisions still land in-app
# and the UI reports that no email went out.
RESEND_API_KEY=
# Required whenever RESEND_API_KEY is set. The domain must be verified in Resend;
# there is deliberately no fallback, since Resend's sandbox domain can only
# deliver to the API key owner.
RESEND_FROM_EMAIL=The Ledger <noreply@yourdomain.com>

# ── Admin panel (optional) ──────────────────────────────────────────────────
# Hostname allowed to reach /admin. In a production build, leaving this unset
# blocks /admin entirely — it fails closed. localhost is always allowed.
# Admin authority itself comes from a user_roles row, not from this variable.
VITE_ADMIN_DOMAIN=

# ── Legal (optional) ───────────────────────────────────────────────────────
# Link target for "terms" on the sign-in card. Plain text when unset.
VITE_TERMS_URL=
